<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.GastosMensualActivity">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">


            <!-- ======================== -->
            <!-- ENCABEZADO -->
            <!-- ======================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="36dp"
                android:fontFamily="sans-serif-black"
                android:text="COMEDOR PARROQUIAL"
                android:textColor="@color/mi_principal"
                android:textSize="20sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"
                android:text="GASTOS MENSUALES"
                android:textColor="@color/mi_cuarto"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- ======================== -->
            <!-- CARD REGISTRO -->
            <!-- ======================== -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardGastosRegistro"
                android:layout_width="340dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="17dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="8dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">


                    <TextView
                        android:id="@+id/txtTituloRegistroGastos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-black"
                        android:text="REGISTRA TUS GASTOS:"
                        android:textColor="@color/mi_marron"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <!-- CARD FECHA -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFechaGastos"
                        android:layout_width="310dp"
                        android:layout_height="65dp"
                        android:layout_marginTop="24dp"
                        app:cardBackgroundColor="@color/material_dynamic_neutral90"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTituloRegistroGastos">


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">


                            <TextView
                                android:id="@+id/txtTituloFechaGastos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="10dp"
                                android:text="FECHA DE REGISTRO:"
                                android:textColor="@color/mi_cuarto"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />


                            <TextView
                                android:id="@+id/txt_fechaGastos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="dd/mm/aa"
                                android:textColor="@color/mi_cuarto"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="@id/txtTituloFechaGastos"
                                app:layout_constraintTop_toBottomOf="@id/txtTituloFechaGastos" />


                            <Button
                                android:id="@+id/btn_seleccionarFechaGastos"
                                android:layout_width="69dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="16dp"
                                android:backgroundTint="@color/mi_marron"
                                app:cornerRadius="5dp"
                                app:icon="@drawable/icono_calendario"
                                app:iconTint="@color/white"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />


                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.cardview.widget.CardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>


            <!-- ======================== -->
            <!-- VERDURAS -->
            <!-- ======================== -->

            <TextView
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:text="VERDURAS:"
                android:textColor="@color/mi_cuarto"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="340dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="#F0F7F1"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:prefixText="S/. "
                app:prefixTextColor="@color/mi_principal"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_verduras"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/mi_cuarto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ======================== -->
            <!-- TAXI CAMAL -->
            <!-- ======================== -->

            <TextView
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="TAXI CAMAL:"
                android:textColor="@color/mi_cuarto"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="340dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="#F0F7F1"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
