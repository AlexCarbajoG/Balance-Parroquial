                    android:maxLines="1"
                    android:textColor="@color/mi_cuarto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ======================== -->
            <!-- ABARROTES -->
            <!-- ======================== -->

