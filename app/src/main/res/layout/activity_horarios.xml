<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.HorariosActivity">

    <TextView
        android:id="@+id/textView24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HORARIOS"
        android:textColor="@color/mi_cuarto"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textView14"
        app:layout_constraintTop_toBottomOf="@+id/textView14" />

    <TextView
        android:id="@+id/textView14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:text="COMEDOR PARROQUIAL"
        android:textColor="@color/mi_principal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.086"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPeriodo"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView24"
        app:strokeColor="#DCE8DD"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- CABECERA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Seleccionar Periodo"
                    android:textColor="@color/mi_cuarto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnioPeriodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E8F3EA"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="2026"
                    android:textColor="@color/mi_principal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- MESES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">


                <!-- MES ANTERIOR -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMesAnterior"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#E8EFE9"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mes Ant."
                            android:textColor="#68736B"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtMesAnterior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sep"
                            android:textColor="@color/mi_cuarto"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- MES ACTUAL -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMesActual"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mi_principal"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Actual"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMesActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- MES SIGUIENTE -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMesSiguiente"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#E8EFE9"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Próximo"
                            android:textColor="#68736B"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtMesSiguiente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nov"
                            android:textColor="@color/mi_cuarto"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResponsableCuadrante"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardPeriodo"
        app:strokeColor="#DCE8DD"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- TÍTULO -->

            <TextView
                android:id="@+id/txtTituloResponsable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Responsable de Cuadrante"
                android:textColor="@color/mi_cuarto"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ============================= -->
            <!-- RESPONSABLE 1 -->
            <!-- ============================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResponsableMaria"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#EDF5EE"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">


                    <!-- INFORMACIÓN -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNombreResponsable1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hilda Quispe Cari"
                            android:textColor="@color/mi_cuarto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCargoResponsable1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Coordinadora de Cocina"
                            android:textColor="#68736B"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <RadioButton
                        android:id="@+id/radioResponsable1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:buttonTint="@color/mi_principal" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ============================= -->
            <!-- RESPONSABLE 2 -->
            <!-- ============================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResponsableJose"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F2F6F2"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNombreResponsable2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Patty Ortiz Quispe"
                            android:textColor="@color/mi_cuarto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCargoResponsable2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ayudamte Part. Time"
                            android:textColor="#68736B"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <RadioButton
                        android:id="@+id/radioResponsable2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:buttonTint="@color/mi_principal" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ============================= -->
            <!-- RESPONSABLE 3 -->
            <!-- ============================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResponsableCarmen"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F2F6F2"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNombreResponsable3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Juana Aynaya Porras"
                            android:textColor="@color/mi_cuarto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCargoResponsable3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ayudamte Part. Time"
                            android:textColor="#68736B"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <RadioButton
                        android:id="@+id/radioResponsable3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:buttonTint="@color/mi_principal" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btn_regresoHorarios"
        android:layout_width="245dp"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/mi_marron"
        android:text="REGRESAR"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button2"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/button2"
        android:layout_width="245dp"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/material_dynamic_neutral80"
        android:text="IMPRIMIR"
        android:textColor="@color/material_dynamic_neutral30"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button3"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/button3"
        android:layout_width="245dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/mi_principal"
        android:text="DESCARGAR"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardResponsableCuadrante"
        tools:ignore="TouchTargetSizeCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>